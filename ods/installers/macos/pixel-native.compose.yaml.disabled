# Apply after extensions/services/pixel-edge/compose.yaml.disabled.
# Not auto-enabled: native custody, licensing and preview prerequisites must
# be qualified by the installer first. Requires Compose supporting !override.
services:
  pixel-native-runtime-init:
    image: busybox:1.36.1
    user: "0:0"
    network_mode: none
    read_only: true
    cap_drop: [ALL]
    cap_add: [CHOWN]
    security_opt: [no-new-privileges:true]
    restart: "no"
    command: [chown, "${PIXEL_NATIVE_UID:?Set PIXEL_NATIVE_UID}:${PIXEL_INGRESS_GID:?Set PIXEL_INGRESS_GID}", /runtime]
    volumes:
      - pixel-native-runtime:/runtime

  pixel-native-ingress:
    image: ${PIXEL_NATIVE_INGRESS_IMAGE:?Set the qualified Pixel ingress Node image}
    user: "${PIXEL_NATIVE_UID:?Set PIXEL_NATIVE_UID}:${PIXEL_INGRESS_GID:?Set PIXEL_INGRESS_GID}"
    entrypoint: [node, /source/pixel_ingress.mjs]
    command: []
    restart: unless-stopped
    read_only: true
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    pids_limit: 128
    depends_on:
      pixel-native-runtime-init:
        condition: service_completed_successfully
    environment:
      PIXEL_GATEWAY_TRANSPORT: docker-desktop-host
      PIXEL_GATEWAY_PORT: "${PIXEL_NATIVE_GATEWAY_PORT:-18789}"
      PIXEL_GATEWAY_TOKEN_FILE: /run/gateway.json
      PIXEL_INGRESS_SOCKET: /runtime/pixel-ingress.sock
      PIXEL_INGRESS_GID: "${PIXEL_INGRESS_GID:?Set PIXEL_INGRESS_GID}"
      PIXEL_STATUS_FILE: /runtime/status.json
      PIXEL_CHAT_STATE_DIR: /runtime/history
    volumes:
      - pixel-native-runtime:/runtime
      - type: bind
        source: ./extensions/services/pixel-agent/host
        target: /source
        read_only: true
        bind:
          create_host_path: false
      - type: bind
        source: ${PIXEL_NATIVE_CONFIG_PATH:?Set PIXEL_NATIVE_CONFIG_PATH}
        target: /run/gateway.json
        read_only: true
        bind:
          create_host_path: false
    healthcheck:
      test: [CMD, node, -e, "require('http').get({socketPath:'/runtime/pixel-ingress.sock',path:'/health'},r=>{r.resume();process.exit(r.statusCode===200?0:1)}).on('error',()=>process.exit(1))"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 5s
    deploy:
      resources:
        limits:
          cpus: '1'
          memory: 256M
          pids: 128
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: '3'

  pixel-edge:
    # Replace the Linux host UDS bind with the ingress-owned Docker volume.
    # Keep preview and transition storage from the shared Edge contract.
    volumes: !override
      - pixel-native-runtime:/pixel-runtime:ro
      - "${PIXEL_PREVIEW_RUNTIME_DIR:?Set PIXEL_PREVIEW_RUNTIME_DIR}:/pixel-preview-runtime:ro"
      - pixel-transition-state:/pixel-transition-state

volumes:
  pixel-native-runtime:
